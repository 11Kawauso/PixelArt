rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // クラウド保存は運営者（11Kawauso）のアカウントだけが使える。
    // 誰でもログインできるため、運営者以外に保存を許すと、大量保存で無料枠を
    // 使い切られたり、無関係なデータの置き場所にされたりするおそれがある。
    // 運営者以外は「作品ファイルとして保存」で自分のフォルダに保存してもらう。
    //
    // 下のUIDは運営者のアカウントのもの（Firebaseコンソールの
    // Authentication → ユーザー の「ユーザー UID」列で確認できる）
    match /users/{uid}/artworks/{artworkId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && uid == 'B3n2pallCKcjkY3cyJoQg8At3tT2';
    }
  }
}
